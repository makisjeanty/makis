# Configurações de Segurança e Django
SECRET_KEY=sua_secret_key_aqui_gerada_aleatoriamente
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ADMIN_URL=gestao-dmh8g6skcx
# Painel de Monitoria (pode ser ofuscado como o admin)
MONITORIA_URL=monitoria
# Token secreto do Webhook Kiwify (configure o mesmo no painel Kiwify)
KIWIFY_TOKEN=seu_token_secreto_aqui

# Conexão com Banco de Dados MySQL
DB_NAME=base_central
DB_USER=user_central
DB_PASSWORD=sua_senha_mysql_aqui
# Só usado pelo docker-compose.yml (senha do usuário root do container MySQL)
DB_ROOT_PASSWORD=sua_senha_root_mysql_aqui
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis (para Channels / WebSockets e Caching em Produção)
REDIS_URL=redis://127.0.0.1:6379/0

# Configurações de E-mail (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=contato@makisdigital.com
EMAIL_HOST_PASSWORD=sua_senha_email_aqui
